<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uvdar_gazebo_plugin</name>
  <version>2.0.0</version>
  <description>The UVDAR Gazebo Sim Plugin for ROS 2</description>
  <maintainer email="viktor.walter@fel.cvut.cz">Viktor Walter</maintainer>
  <license>BSD 3-Clause</license>

  <!-- Build Tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- C++ Runtime Dependencies -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  
  <!-- MRS & Custom Dependencies -->
  <!-- Ensure these packages are installed as ROS 2 packages -->
  <depend>mrs_msgs</depend>
  <depend>uvdar_core</depend>
  
  <!-- Gazebo Sim Dependencies -->
  <depend>gz-sim8</depend>
  <depend>gz-transport13</depend>

  <!-- OpenCV -->
  <depend>OpenCV</depend>

  <!-- Message Generation Dependencies -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Test Dependencies (Optional) -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
